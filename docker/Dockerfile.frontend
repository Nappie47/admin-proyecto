# ============================================================
# Dockerfile Frontend - Hardened para AWS EC2
# Multi-stage: Build (Node 20) -> Runtime (Nginx Unprivileged)
# Autores: Bryan Ahumada & Johan Muñoz
# ============================================================

FROM node:20-alpine3.20 AS builder

WORKDIR /app

COPY services/frontend/package*.json ./
RUN npm ci

ARG VITE_GOOGLE_MAPS_API_KEY
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY

COPY services/frontend/ .
RUN npm run build

# Runtime Stage: Nginx Unprivileged
FROM nginxinc/nginx-unprivileged:1.27-alpine

LABEL maintainer="Bryan Ahumada & Johan Muñoz" \
      version="3.0.0" \
      description="Frontend Hardened Nginx Unprivileged - Unidad 3"

COPY --from=builder /app/dist /usr/share/nginx/html
COPY services/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/health || exit 1

USER 101

CMD ["nginx", "-g", "daemon off;"]

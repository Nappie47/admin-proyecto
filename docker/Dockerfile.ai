# ============================================================
# Dockerfile AI Service - Hardened para AWS EC2
# OpenCV + Detección Facial Biométrica
# Autores: Bryan Ahumada & Johan Muñoz
# ============================================================

FROM python:3.11-slim-bookworm

LABEL maintainer="Bryan Ahumada & Johan Muñoz" \
      version="3.0.0" \
      description="Microservicio IA Biometria Facial Hardened - Unidad 3"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AI_DATA_DIR=/app/data/faces \
    PORT=5001

# Usuario no root seguro
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /sbin/nologin -d /app appuser

# Dependencias minimas de sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY services/ai-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=appuser:appgroup services/ai-service /app
RUN mkdir -p /app/data/faces && chown -R appuser:appgroup /app/data/faces

USER appuser
EXPOSE 5001

HEALTHCHECK --interval=20s --timeout=5s --retries=3 --start-period=10s \
    CMD curl -f http://127.0.0.1:5001/health || exit 1

CMD ["gunicorn", "--bind", "0.0.0.0:5001", "--workers", "2", "--threads", "2", "--timeout", "60", "app:app"]

# ============================================================
# Variables de entorno para desarrollo local
# Copiar a .env y completar valores
# ============================================================

# Database
DB_PASSWORD=cambiar_por_password_seguro_32_chars_min

# Redis
REDIS_PASSWORD=cambiar_por_password_seguro_32_chars_min

# JWT
JWT_SECRET=cambiar_por_clave_secreta_jwt_64_chars_min

# pgAdmin
PGADMIN_PASSWORD=admin123

# Redis Commander
REDIS_COMMANDER_PASSWORD=admin123

# Slack webhook (opcional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX

# GitHub Token (para gitleaks)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Cosign Public Key (para verificación de firmas)
COSIGN_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----
# ==============================================================================
# VARIABLES DE ENTORNO: ARQUITECTURA CLOUD GOOGLE CLOUD PLATFORM
# ==============================================================================
APP_ENV=production

# Dirección IP Privada asignada a Cloud SQL (ej. 10.10.0.5)
DB_HOST=10.10.0.5
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TuPasswordSeguroCloudSQL2026!
DB_NAME=cementerio_db

# Claves Criptográficas
SECRET_KEY=cementerio-los-angeles-secret-key-2026-prod
JWT_SECRET_KEY=cementerio-jwt-super-secret-key-2026-prod
CORS_ORIGINS=*

# En la primera VM puedes poner true si quieres que inserte los datos demo iniciales automáticamente:
RUN_SEED=false

# ==============================================================================
# Variables de Entorno - Entorno Seguro SIG Cementerio General de Los Ángeles
# Copiar este archivo a .env antes del despliegue: cp .env.example .env
# ==============================================================================

# Configuración General del Entorno
APP_ENV=production
DEBUG=False
PORT=5000
SECRET_KEY=cambiar-por-una-clave-secreta-aleatoria-de-mas-de-32-caracteres
JWT_SECRET_KEY=cambiar-por-otro-secreto-jwt-aleatorio-de-mas-de-32-caracteres

# Configuración de Base de Datos PostgreSQL + PostGIS (vía HAProxy DB)
DB_USER=postgres
DB_PASSWORD=postgres_secure_password_2026
DB_NAME=cementerio_db
DB_HOST=haproxy_db
DB_PORT=5000
DATABASE_URL=postgresql://postgres:postgres_secure_password_2026@haproxy_db:5000/cementerio_db

# Puertos Expuestos en el Host
GATEWAY_PORT=80
HAPROXY_DB_STATS_PORT=7000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Credenciales de Administrador Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_grafana_2026!

# Orígenes Permitidos CORS
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1


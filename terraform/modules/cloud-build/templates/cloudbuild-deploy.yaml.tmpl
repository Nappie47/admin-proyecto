# Cloud Build Configuration - Deploy Pipeline
# Deploy manual o automático a Cloud Run

steps:
# ============================================================
# PASO 1: Pull latest images
# ============================================================
- name: 'gcr.io/cloud-builders/docker'
  id: 'pull-api'
  args: ['pull', '${_ARTIFACT_REGISTRY}/api:${_IMAGE_TAG}']

- name: 'gcr.io/cloud-builders/docker'
  id: 'pull-frontend'
  args: ['pull', '${_ARTIFACT_REGISTRY}/frontend:${_IMAGE_TAG}']

- name: 'gcr.io/cloud-builders/docker'
  id: 'pull-ai'
  args: ['pull', '${_ARTIFACT_REGISTRY}/ai-service:${_IMAGE_TAG}']

# ============================================================
# PASO 2: Deploy API a Cloud Run
# ============================================================
- name: 'gcr.io/google.com/cloudsdktool/cloud-sdk'
  id: 'deploy-api'
  entrypoint: 'gcloud'
  args: [
    'run', 'deploy', '${_SERVICE_NAME_API}',
    '--image', '${_ARTIFACT_REGISTRY}/api:${_IMAGE_TAG}',
    '--region', '${_REGION}',
    '--platform', 'managed',
    '--service-account', '${_SERVICE_ACCOUNT_EMAIL}',
    '--vpc-connector', '${_VPC_CONNECTOR}',
    '--vpc-egress', 'all-traffic',
    '--min-instances', '${_MIN_INSTANCES_API}',
    '--max-instances', '${_MAX_INSTANCES_API}',
    '--cpu', '${_CPU_API}',
    '--memory', '${_MEMORY_API}',
    '--concurrency', '${_CONCURRENCY_API}',
    '--set-env-vars', 'ENVIRONMENT=production,DB_HOST=/cloudsql/${_CLOUDSQL_INSTANCE},DB_PORT=5432,DB_NAME=${_DB_NAME},DB_USER=${_DB_USER},REDIS_HOST=${_REDIS_HOST},REDIS_PORT=6379',
    '--set-secrets', 'DB_PASSWORD=${_DB_PASSWORD_SECRET}:latest,JWT_SECRET=${_JWT_SECRET}:latest,REDIS_PASSWORD=${_REDIS_PASSWORD_SECRET}:latest',
    '--ingress', 'internal',
    '--cpu-throttling', 'true',
    '--execution-environment', 'gen2',
    '--no-cpu-throttling=false',
    '--labels', 'managed-by=cloudbuild,environment=production,version=${_IMAGE_TAG}',
    '--quiet'
  ]

# ============================================================
# PASO 3: Deploy Frontend a Cloud Run
# ============================================================
- name: 'gcr.io/google.com/cloudsdktool/cloud-sdk'
  id: 'deploy-frontend'
  entrypoint: 'gcloud'
  args: [
    'run', 'deploy', '${_SERVICE_NAME_FRONTEND}',
    '--image', '${_ARTIFACT_REGISTRY}/frontend:${_IMAGE_TAG}',
    '--region', '${_REGION}',
    '--platform', 'managed',
    '--service-account', '${_SERVICE_ACCOUNT_EMAIL}',
    '--vpc-connector', '${_VPC_CONNECTOR}',
    '--vpc-egress', 'all-traffic',
    '--min-instances', '${_MIN_INSTANCES_FRONTEND}',
    '--max-instances', '${_MAX_INSTANCES_FRONTEND}',
    '--cpu', '${_CPU_FRONTEND}',
    '--memory', '${_MEMORY_FRONTEND}',
    '--concurrency', '${_CONCURRENCY_FRONTEND}',
    '--set-env-vars', 'ENVIRONMENT=production,API_URL=https://${_API_DOMAIN}',
    '--ingress', 'internal',
    '--execution-environment', 'gen2',
    '--labels', 'managed-by=cloudbuild,environment=production,version=${_IMAGE_TAG}',
    '--quiet'
  ]

# ============================================================
# PASO 3: Deploy AI Service a Cloud Run
# ============================================================
- name: 'gcr.io/google.com/cloudsdktool/cloud-sdk'
  id: 'deploy-ai'
  entrypoint: 'gcloud'
  args: [
    'run', 'deploy', '${_SERVICE_NAME_AI}',
    '--image', '${_ARTIFACT_REGISTRY}/ai-service:${_IMAGE_TAG}',
    '--region', '${_REGION}',
    '--platform', 'managed',
    '--service-account', '${_SERVICE_ACCOUNT_EMAIL}',
    '--vpc-connector', '${_VPC_CONNECTOR}',
    '--vpc-egress', 'all-traffic',
    '--min-instances', '${_MIN_INSTANCES_AI}',
    '--max-instances', '${_MAX_INSTANCES_AI}',
    '--cpu', '${_CPU_AI}',
    '--memory', '${_MEMORY_AI}',
    '--concurrency', '${_CONCURRENCY_AI}',
    '--set-env-vars', 'ENVIRONMENT=production,MODEL_PATH=/models',
    '--ingress', 'internal',
    '--execution-environment', 'gen2',
    '--labels', 'managed-by=cloudbuild,environment=production,version=${_IMAGE_TAG}',
    '--quiet'
  ]

# ============================================================
# PASO 4: Verificar despliegue (Health checks)
# ============================================================
- name: 'gcr.io/cloud-builders/curl'
  id: 'health-check-api'
  args: [
    '-f', '-s', '-o', '/dev/null', '-w', '%{http_code}',
    'https://${_API_DOMAIN}/health'
  ]

- name: 'gcr.io/cloud-builders/curl'
  id: 'health-check-frontend'
  args: [
    '-f', '-s', '-o', '/dev/null', '-w', '%{http_code}',
    'https://${_FRONTEND_DOMAIN}/health'
  ]

# ============================================================
# PASO 4: Test SSL/TLS Configuration
# ============================================================
- name: 'gcr.io/cloud-builders/docker'
  id: 'testssl-api'
  args: [
    'run', '--rm',
    'drwetter/testssl.sh:latest',
    '--jsonfile', '/workspace/testssl-api.json',
    'https://${_API_DOMAIN}'
  ]

- name: 'gcr.io/cloud-builders/gsutil'
  id: 'upload-testssl-api'
  args: ['cp', 'testssl-api.json', 'gs://${PROJECT_ID}-security-reports/deploy/testssl-api-$(date +%Y%m%d).json']

# ============================================================
# PASO 5: Notificación
# ============================================================
- name: 'gcr.io/cloud-builders/curl'
  id: 'notify-deploy'
  args: [
    '-X', 'POST',
    '-H', 'Content-Type: application/json',
    '-d', '{"text":"🚀 Deploy exitoso v${_IMAGE_TAG} en ${_REGION}"}',
    '${_SLACK_WEBHOOK_URL}'
  ]

# Sustituciones
substitutions:
  _ARTIFACT_REGISTRY: '${artifact_registry}'
  _REGION: '${region}'
  _SERVICE_NAME_API: '${project_name}-api-${suffix}'
  _SERVICE_NAME_FRONTEND: '${project_name}-frontend-${suffix}'
  _SERVICE_NAME_AI: '${project_name}-ai-service-${suffix}'
  _SERVICE_ACCOUNT_EMAIL: '${_SERVICE_ACCOUNT_EMAIL}'
  _VPC_CONNECTOR: '${_VPC_CONNECTOR}'
  _CLOUDSQL_INSTANCE: '${_CLOUDSQL_INSTANCE}'
  _DB_NAME: '${_DB_NAME}'
  _DB_USER: '${_DB_USER}'
  _REDIS_HOST: '${_REDIS_HOST}'
  _DB_PASSWORD_SECRET: '${_DB_PASSWORD_SECRET}'
  _JWT_SECRET: '${_JWT_SECRET}'
  _REDIS_PASSWORD_SECRET: '${_REDIS_PASSWORD_SECRET}'
  _MIN_INSTANCES_API: '0'
  _MAX_INSTANCES_API: '10'
  _CPU_API: '1000m'
  _MEMORY_API: '512Mi'
  _CONCURRENCY_API: '80'
  _MIN_INSTANCES_FRONTEND: '0'
  _MAX_INSTANCES_FRONTEND: '10'
  _CPU_FRONTEND: '500m'
  _MEMORY_FRONTEND: '256Mi'
  _CONCURRENCY_FRONTEND: '80'
  _MIN_INSTANCES_AI: '0'
  _MAX_INSTANCES_AI: '3'
  _CPU_AI: '2000m'
  _MEMORY_AI: '2Gi'
  _CONCURRENCY_AI: '10'
  _API_DOMAIN: '${_API_DOMAIN}'
  _FRONTEND_DOMAIN: '${_FRONTEND_DOMAIN}'
  _IMAGE_TAG: '${_IMAGE_TAG}'
  _SLACK_WEBHOOK_URL: '${_SLACK_WEBHOOK_URL}'

timeout: '3600s'

options:
  logging: CLOUD_LOGGING_ONLY
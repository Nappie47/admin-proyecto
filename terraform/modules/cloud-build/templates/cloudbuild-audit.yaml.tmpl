# Cloud Build Configuration - Security Audit Pipeline
# Ejecutado periódicamente (semanal) para auditoría de hardening

steps:
# ============================================================
# PASO 1: Pull latest images
# ============================================================
- name: 'gcr.io/cloud-builders/docker'
  id: 'pull-api'
  args: ['pull', '${_ARTIFACT_REGISTRY}/api:latest']

- name: 'gcr.io/cloud-builders/docker'
  id: 'pull-frontend'
  args: ['pull', '${_ARTIFACT_REGISTRY}/frontend:latest']

- name: 'gcr.io/cloud-builders/docker'
  id: 'pull-ai'
  args: ['pull', '${_ARTIFACT_REGISTRY}/ai-service:latest']

# ============================================================
# PASO 2: Trivy Vulnerability Scanning (CRITICAL/HIGH)
# ============================================================
- name: 'aquasec/trivy:latest'
  id: 'trivy-api'
  args: [
    'image',
    '--severity', 'HIGH,CRITICAL',
    '--format', 'table',
    '--output', '/workspace/trivy-api.txt',
    '${_ARTIFACT_REGISTRY}/api:latest'
  ]
  env:
    - 'TRIVY_DB_REPOSITORY=public.ecr.aws/aquasecurity/trivy-db:2'

- name: 'gcr.io/cloud-builders/gsutil'
  id: 'upload-trivy-api'
  args: ['cp', 'trivy-api.txt', 'gs://${PROJECT_ID}-security-reports/audit/trivy/api-$(date +%Y%m%d).txt']

- name: 'aquasec/trivy:latest'
  id: 'trivy-frontend'
  args: [
    'image',
    '--severity', 'HIGH,CRITICAL',
    '--format', 'table',
    '--output', '/workspace/trivy-frontend.txt',
    '${_ARTIFACT_REGISTRY}/frontend:latest'
  ]

- name: 'gcr.io/cloud-builders/gsutil'
  id: 'upload-trivy-frontend'
  args: ['cp', 'trivy-frontend.txt', 'gs://${PROJECT_ID}-security-reports/audit/trivy/frontend-$(date +%Y%m%d).txt']

- name: 'aquasec/trivy:latest'
  id: 'trivy-ai'
  args: [
    'image',
    '--severity', 'HIGH,CRITICAL',
    '--format', 'table',
    '--output', '/workspace/trivy-ai.txt',
    '${_ARTIFACT_REGISTRY}/ai-service:latest'
  ]

- name: 'gcr.io/cloud-builders/gsutil'
  id: 'upload-trivy-ai'
  args: ['cp', 'trivy-ai.txt', 'gs://${PROJECT_ID}-security-reports/audit/trivy/ai-$(date +%Y%m%d).txt']

# ============================================================
# PASO 3: Grype Vulnerability Scanning (alternativa)
# ============================================================
- name: 'anchore/grype:latest'
  id: 'grype-api'
  args: [
    '${_ARTIFACT_REGISTRY}/api:latest',
    '-o', 'table',
    '--fail-on', 'high'
  ]

- name: 'anchore/grype:latest'
  id: 'grype-frontend'
  args: [
    '${_ARTIFACT_REGISTRY}/frontend:latest',
    '-o', 'table',
    '--fail-on', 'high'
  ]

- name: 'anchore/grype:latest'
  id: 'grype-ai'
  args: [
    '${_ARTIFACT_REGISTRY}/ai-service:latest',
    '-o', 'table',
    '--fail-on', 'high'
  ]

# ============================================================
# PASO 4: Lynis Hardening Audit (en contenedor temporal)
# ============================================================
- name: 'gcr.io/cloud-builders/docker'
  id: 'lynis-audit'
  args: [
    'run', '--rm',
    '--user', 'root',
    '--cap-add', 'ALL',
    '--pid', 'host',
    '--volume', '/:/host:ro',
    'cisofy/lynis:latest',
    'audit', 'system',
    '--quick',
    '--no-colors',
    '--format', 'text'
  ]

# ============================================================
# PASO 5: Gitleaks Secret Scanning (historial completo)
# ============================================================
- name: 'zricethezav/gitleaks:latest'
  id: 'gitleaks-full-history'
  args: [
    'detect',
    '--source', '/workspace',
    '--report-format', 'sarif',
    '--report-path', '/workspace/gitleaks-full.sarif',
    '--verbose',
    '--redact'
  ]
  env:
    - 'GITHUB_TOKEN=${_GITHUB_TOKEN}'

- name: 'gcr.io/cloud-builders/gsutil'
  id: 'upload-gitleaks-audit'
  args: ['cp', 'gitleaks-full.sarif', 'gs://${PROJECT_ID}-security-reports/audit/gitleaks/gitleaks-full-$(date +%Y%m%d).sarif']

# ============================================================
# PASO 6: Container Structure Test (Google)
# ============================================================
- name: 'gcr.io/gcp-runtimes/container-structure-test:latest'
  id: 'structure-test-api'
  args: [
    'test',
    '--image', '${_ARTIFACT_REGISTRY}/api:latest',
    '--config', '/workspace/tests/container-structure-test.yaml'
  ]

# ============================================================
# PASO 7: Syft SBOM Generation
# ============================================================
- name: 'anchore/syft:latest'
  id: 'sbom-api'
  args: [
    '${_ARTIFACT_REGISTRY}/api:latest',
    '-o', 'spdx-json=/workspace/sbom-api.spdx.json'
  ]

- name: 'gcr.io/cloud-builders/gsutil'
  id: 'upload-sbom-api'
  args: ['cp', 'sbom-api.spdx.json', 'gs://${PROJECT_ID}-security-reports/audit/sbom/api-$(date +%Y%m%d).spdx.json']

- name: 'anchore/syft:latest'
  id: 'sbom-frontend'
  args: [
    '${_ARTIFACT_REGISTRY}/frontend:latest',
    '-o', 'spdx-json=/workspace/sbom-frontend.spdx.json'
  ]

- name: 'gcr.io/cloud-builders/gsutil'
  id: 'upload-sbom-frontend'
  args: ['cp', 'sbom-frontend.spdx.json', 'gs://${PROJECT_ID}-security-reports/audit/sbom/frontend-$(date +%Y%m%d).spdx.json']

# ============================================================
# PASO 8: Cosign Signature Verification (si se usa)
# ============================================================
- name: 'gcr.io/projectsigstore/cosign:v2.2.0'
  id: 'cosign-verify-api'
  args: [
    'verify',
    '--key', '${_COSIGN_PUBLIC_KEY}',
    '${_ARTIFACT_REGISTRY}/api:latest'
  ]

# ============================================================
# PASO 9: Generate Audit Report
# ============================================================
- name: 'gcr.io/cloud-builders/gsutil'
  id: 'generate-report'
  args: [
    'cp', '-r', '/workspace/*', 'gs://${PROJECT_ID}-security-reports/audit/$(date +%Y%m%d)/'
  ]

# Configuración
substitutions:
  _ARTIFACT_REGISTRY: '${artifact_registry}'

timeout: '7200s'

options:
  logging: CLOUD_LOGGING_ONLY
  default_logs_bucket_behavior: REGIONAL_USER_OWNED_BUCKET
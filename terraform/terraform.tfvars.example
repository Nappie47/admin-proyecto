# ============================================================
# Ejemplo de Variables para Despliegue en AWS
# Copiar este archivo a terraform.tfvars
# ============================================================

aws_region         = "us-east-1"
project_name       = "cementerio-los-angeles-u3"
environment        = "production"
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
private_subnet_cidr= "10.0.2.0/24"
availability_zone  = "us-east-1a"
instance_type      = "t3.medium"
key_name           = "cemetery-u3-key" # Tu llave creada en EC2 Key Pairs

# REEMPLAZAR con la IP publica de tu conexion a Internet para restringir el puerto SSH (22):
# Puedes obtenerla en https://checkip.amazonaws.com
admin_ssh_ip       = "0.0.0.0/0"

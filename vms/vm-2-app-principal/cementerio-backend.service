[Unit]
Description=API REST Backend Flask Cementerio (Gunicorn)
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/cementerio-backend
EnvironmentFile=/var/www/cementerio-backend/.env
ExecStart=/var/www/cementerio-backend/venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 --timeout 120 "app:create_app()"
Restart=always

[Install]
WantedBy=multi-user.target

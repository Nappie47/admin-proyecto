# Variables de Entorno - VM 2 (Servidor de Aplicaciones 1 - Principal)
FLASK_ENV=production
SECRET_KEY=clave-secreta-cementerio-los-angeles-2026-prod
JWT_SECRET_KEY=jwt-token-secreto-cementerio-los-angeles-2026

# Conexión hacia la Capa 3 (Balanceador de Base de Datos HAProxy en puerto 5000)
DATABASE_URL=postgresql://postgres:postgres123@vm4_haproxy_db:5000/cementerio_db
DB_HOST=vm4_haproxy_db
DB_PORT=5000
DB_NAME=cementerio_db
DB_USER=postgres
DB_PASSWORD=postgres123

# Identificador de instancia para métricas y balanceo
INSTANCE_ID=vm-2-app-principal

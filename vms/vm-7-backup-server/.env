# Variables de Entorno - VM 7 (Servidor de Respaldo)
DB_HOST=vm5_db_primaria
DB_PORT=5432
DB_NAME=cementerio_db
DB_USER=postgres
PGPASSWORD=postgres123

# Frecuencia de respaldo automático en minutos (por defecto 60 min)
